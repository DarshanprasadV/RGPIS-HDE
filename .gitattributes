# GitHub Linguist Language Configuration
# Suppress Kotlin detection completely (no mobile or kotlin in repository)
*.kt -linguist-detectable
*.kts -linguist-detectable
*.kt linguist-detectable=false
*.kts linguist-detectable=false
mobile_app/** -linguist-detectable
mobile_app/** linguist-detectable=false

# Mark generated HTML dashboards and artifacts as vendored
# so that Python reflects as the primary codebase language on GitHub
*.html linguist-vendored=true
*.html -linguist-detectable
outputs/** linguist-vendored=true
outputs/** -linguist-detectable
